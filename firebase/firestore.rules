rules_version = '2';

// COLD FORGE — Firestore security rules.
//
// Data model: docs/firebase.md. Everything lives under users/{uid}; only that user (signed in
// with Google, verified email, not blocked) can read or write it. Nothing else is
// client-accessible: adminAuditLog, adminRateLimits, quota and blocked are written by Cloud
// Functions with the Admin SDK, which bypasses rules.
//
// The checks mirror packages/sync/src/validate.ts (LIMITS, WRITE_BOUNDS) as far as the rules
// language allows: exact key sets, types, lengths (UTF-16 units: string.size() == JS .length),
// enums, ISO formats, the 5-minute clock-skew limit, bounded key spaces (dates and timestamps),
// doc id == record id, live references (habit -> arc, check-in -> habit), createdAt immutable and
// last-write-wins on updatedAt. Clients never delete: deletions are tombstones (deletedAt), and
// account deletion goes through Firebase Auth (the onUserDeleted function removes the data).
//
// NOT expressible here (enforced by the client's shared validator instead):
//  - emoji grapheme counting ("one or two emoji"): approximated by length and an explicit
//    whitelist of emoji code points / sequence characters;
//  - "renders as blank" (isBlank) for every invisible code point: approximated with
//    whitespace/space separators/marks/format characters;
//  - lone surrogates: Firestore stores UTF-8, so they can't reach a document anyway;
//  - per-user document counts: Cloud Functions count them (quota/{uid}) and set blocked/{uid}.
//
// Timestamps (createdAt, updatedAt, deletedAt) are canonical ISO-8601 UTC strings with exactly
// three fractional digits ("2026-10-05T12:00:00.000Z"), so they compare correctly as strings
// (last-write-wins) and are parsed into a timestamp for the range checks.
// syncedAt is a real Firestore timestamp: always request.time (serverTimestamp()).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who ----------

    // A blocked account (blocked/{uid}: disabled or deleted by an admin, deleted account, over
    // quota) loses access at once, without waiting up to an hour for its ID token to expire.
    // The exists() costs one document read per request (per get/query/listener attach/batch),
    // not per document returned.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid));
    }

    // ---------- Primitives ----------

    function isId(v) {
      return v is string
        && v.matches('^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$');
    }

    // YYYY-MM-DD that is a real calendar date (02-30 is rejected by the round trip).
    function isDate(v) {
      return v is string
        && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && dateRoundTrips(v.split('-'));
    }
    function dateRoundTrips(p) {
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])).month() == int(p[1])
        && timestamp.date(int(p[0]), int(p[1]), int(p[2])).day() == int(p[2]);
    }
    // UTC midnight of a valid YYYY-MM-DD.
    function dateToTime(v) {
      let p = v.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    function isoToTime(v) {
      let p = v.split('[-T:.Z]');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]))
        + duration.time(int(p[3]), int(p[4]), int(p[5]), int(p[6]) * 1000000);
    }

    // Canonical ISO UTC timestamp, a real date, not before 2024-01-01 (WRITE_BOUNDS.minTimestamp)
    // and at most 5 minutes ahead of the server clock (a far-future value would win every
    // last-write-wins merge forever).
    function isTime(v) {
      return v is string
        && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
        && v >= '2024-01-01T00:00:00.000Z'
        && dateRoundTrips(v.split('[-T:.Z]'))
        && isoToTime(v) <= request.time + duration.value(5, 'm');
    }

    // C0/C1 controls (tab/newline handled separately), soft hyphen, Arabic letter mark,
    // Mongolian vowel separator, zero-width chars and directional marks, line/paragraph
    // separators, bidi embeddings/overrides/isolates, invisible operators, BOM, tag characters.
    function hasUnsafe(v) {
      return v.matches('(?s).*[\\x{0}-\\x{8}\\x{B}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}\\x{E0000}-\\x{E007F}].*');
    }
    // "Zalgo": 4+ combining marks in a row.
    function hasZalgo(v) {
      return v.matches('(?s).*\\p{M}{4,}.*');
    }
    // Renders as nothing: ASCII whitespace, every Unicode space separator (\p{Z}: NBSP, U+3000,
    // U+2000–U+200A, …; RE2's \s is ASCII-only), marks, format characters and blank lookalikes.
    function isBlank(v) {
      return v.matches('^[\\s\\p{Z}\\p{M}\\p{Cf}\\x{2800}\\x{3164}\\x{115F}\\x{1160}\\x{FFA0}]*$');
    }

    function isText(v, max, multiline) {
      return v is string
        && v.size() <= max
        && !hasUnsafe(v)
        && !hasZalgo(v)
        && (multiline || !v.matches('(?s).*[\\t\\n].*'));
    }

    // "" or something visible (a name of only spaces / NBSP / U+3000 is refused).
    function emptyOrVisible(v) {
      return v == '' || !isBlank(v);
    }

    // 1–16 UTF-16 units made only of emoji: pictographs (explicit ranges, since the rules regex
    // engine's Unicode tables may predate newer emoji; regional indicators and skin tones are in
    // U+1F000–U+1FAFF), keycaps ([0-9#*] FE0F? 20E3), subdivision flags (U+1F3F4 + tag letters/digits
    // + CANCEL TAG), joined by ZWJ / VS16. No ASCII letters, spaces, '<' or '>'.
    // Same code points as EMOJI_STRICT in packages/sync/src/validate.ts.
    function isEmoji(v) {
      return v is string
        && v.size() >= 1 && v.size() <= 16
        && v.matches('^([\\x{A9}\\x{AE}\\x{203C}\\x{2049}\\x{2122}\\x{2139}\\x{2194}-\\x{2199}\\x{21A9}\\x{21AA}\\x{231A}\\x{231B}\\x{2328}\\x{23CF}\\x{23E9}-\\x{23F3}\\x{23F8}-\\x{23FA}\\x{24C2}\\x{25AA}\\x{25AB}\\x{25B6}\\x{25C0}\\x{25FB}-\\x{25FE}\\x{2600}-\\x{27BF}\\x{2934}\\x{2935}\\x{2B05}-\\x{2B07}\\x{2B1B}\\x{2B1C}\\x{2B50}\\x{2B55}\\x{3030}\\x{303D}\\x{3297}\\x{3299}\\x{1F000}-\\x{1FAFF}]|[0-9#*]\\x{FE0F}?\\x{20E3}|\\x{1F3F4}[\\x{E0030}-\\x{E0039}\\x{E0061}-\\x{E007A}]{1,6}\\x{E007F})([\\x{A9}\\x{AE}\\x{203C}\\x{2049}\\x{2122}\\x{2139}\\x{2194}-\\x{2199}\\x{21A9}\\x{21AA}\\x{231A}\\x{231B}\\x{2328}\\x{23CF}\\x{23E9}-\\x{23F3}\\x{23F8}-\\x{23FA}\\x{24C2}\\x{25AA}\\x{25AB}\\x{25B6}\\x{25C0}\\x{25FB}-\\x{25FE}\\x{2600}-\\x{27BF}\\x{2934}\\x{2935}\\x{2B05}-\\x{2B07}\\x{2B1B}\\x{2B1C}\\x{2B50}\\x{2B55}\\x{3030}\\x{303D}\\x{3297}\\x{3299}\\x{1F000}-\\x{1FAFF}\\x{200D}\\x{FE0F}]|[0-9#*]\\x{FE0F}?\\x{20E3}|\\x{1F3F4}[\\x{E0030}-\\x{E0039}\\x{E0061}-\\x{E007A}]{1,6}\\x{E007F})*$');
    }

    function optionalTime(d, key) {
      return !(key in d) || isTime(d[key]);
    }

    // createdAt <= updatedAt (canonical strings compare chronologically).
    function ordered(d) {
      return d.createdAt <= d.updatedAt;
    }

    // Every write stamps the server time.
    function stamped(d) {
      return d.syncedAt == request.time;
    }

    // Last-write-wins: a create, or an update with a strictly newer updatedAt.
    function newer() {
      return resource == null || request.resource.data.updatedAt > resource.data.updatedAt;
    }

    // createdAt never changes once written.
    function keepsCreatedAt() {
      return resource == null || request.resource.data.createdAt == resource.data.createdAt;
    }

    function userDoc(uid, coll, id) {
      return /databases/$(database)/documents/users/$(uid)/$(coll)/$(id);
    }

    // ---------- Records ----------

    // WRITE_BOUNDS: starts on/after 2024-01-01, at most 366 days (inclusive).
    function isArc(d, id) {
      return d.keys().hasOnly(['id', 'kind', 'startDate', 'endDate', 'why', 'createdAt', 'updatedAt', 'deletedAt', 'syncedAt'])
        && d.keys().hasAll(['id', 'kind', 'startDate', 'endDate', 'why', 'createdAt', 'updatedAt', 'syncedAt'])
        && d.id == id && isId(id)
        && d.kind in ['winter', 'custom']
        && isDate(d.startDate) && isDate(d.endDate) && d.startDate <= d.endDate
        && d.startDate >= '2024-01-01'
        && dateToTime(d.endDate) - dateToTime(d.startDate) <= duration.value(365, 'd')
        && isText(d.why, 280, true)
        && isTime(d.createdAt) && isTime(d.updatedAt) && optionalTime(d, 'deletedAt') && ordered(d)
        && stamped(d);
    }

    // The arc must exist under the same user (after this batch, so arc + habits can go together)
    // and be live, unless the habit itself is being tombstoned.
    function isHabit(uid, d, id) {
      return d.keys().hasOnly(['id', 'arcId', 'templateId', 'name', 'emoji', 'order', 'createdAt', 'updatedAt', 'deletedAt', 'syncedAt'])
        && d.keys().hasAll(['id', 'arcId', 'name', 'emoji', 'order', 'createdAt', 'updatedAt', 'syncedAt'])
        && d.id == id && isId(id)
        && isId(d.arcId)
        && (!('templateId' in d) || d.templateId in ['coldShower', 'gym', 'read', 'wakeEarly', 'noSugar', 'lessSocial', 'meditate', 'steps', 'water', 'journal'])
        && isText(d.name, 60, false)
        && (d.name == '' ? 'templateId' in d : !isBlank(d.name))
        && isEmoji(d.emoji)
        && d.order is int && d.order >= 0 && d.order <= 10000
        && isTime(d.createdAt) && isTime(d.updatedAt) && optionalTime(d, 'deletedAt') && ordered(d)
        && stamped(d)
        && existsAfter(userDoc(uid, 'arcs', d.arcId))
        && ('deletedAt' in d || !('deletedAt' in getAfter(userDoc(uid, 'arcs', d.arcId)).data));
    }

    // WRITE_BOUNDS: the date lies within [now - 400 days, now + 2 days]. With a bounded window
    // per habit, the number of check-in documents an account can create is bounded too.
    // The habit must exist (after this batch) and not be tombstoned (getAfter of a missing doc
    // is an error, i.e. denied).
    function isCheckIn(uid, d, id) {
      return d.keys().hasOnly(['habitId', 'date', 'done', 'updatedAt', 'syncedAt'])
        && d.keys().hasAll(['habitId', 'date', 'done', 'updatedAt', 'syncedAt'])
        && isId(d.habitId) && isDate(d.date)
        && id == d.habitId + '_' + d.date
        && dateToTime(d.date) >= request.time - duration.value(400, 'd')
        && dateToTime(d.date) <= request.time + duration.value(2, 'd')
        && d.done is bool
        && isTime(d.updatedAt)
        && stamped(d)
        && !('deletedAt' in getAfter(userDoc(uid, 'habits', d.habitId)).data);
    }

    // currentArcId is null or an arc of this user that exists after this write.
    function isProfile(uid, d) {
      return d.keys().hasOnly(['displayName', 'locale', 'currentArcId', 'updatedAt', 'createdAt', 'syncedAt'])
        && d.keys().hasAll(['displayName', 'locale', 'currentArcId', 'updatedAt', 'createdAt', 'syncedAt'])
        && isText(d.displayName, 40, false)
        && emptyOrVisible(d.displayName)
        && d.locale in ['en', 'es', 'pt']
        && (d.currentArcId == null || (isId(d.currentArcId) && existsAfter(userDoc(uid, 'arcs', d.currentArcId))))
        && isTime(d.updatedAt) && isTime(d.createdAt) && ordered(d)
        && stamped(d);
    }

    // ---------- Paths ----------

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isProfile(uid, request.resource.data) && newer() && keepsCreatedAt();
      // No client deletes anywhere: account deletion is user.delete() in Firebase Auth, and the
      // onUserDeleted function blocks the uid and removes users/{uid} recursively.
      allow delete: if false;

      match /arcs/{arcId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isArc(request.resource.data, arcId) && newer() && keepsCreatedAt();
        allow delete: if false;
      }

      match /habits/{habitId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isHabit(uid, request.resource.data, habitId) && newer() && keepsCreatedAt();
        allow delete: if false;
      }

      match /checkIns/{checkInId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isCheckIn(uid, request.resource.data, checkInId) && newer();
        allow delete: if false;
      }
    }

    // Everything else (adminAuditLog, adminRateLimits, quota, blocked, unknown collections,
    // other users) is denied: no rule matches.
  }
}
