{
  "name": "cold-forge",
  "private": true,
  "description": "COLD FORGE — trackea y presume tu progreso en el Winter Arc.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@cold-forge/api' --filter '@cold-forge/app' dev",
    "dev:api": "bun run --filter '@cold-forge/api' dev",
    "dev:app": "bun run --filter '@cold-forge/app' dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
