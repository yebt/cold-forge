{
  "name": "cold-forge",
  "private": true,
  "description": "COLD FORGE — trackea y presume tu progreso en el Winter Arc.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "firebase"
  ],
  "scripts": {
    "dev": "bun run --filter '@cold-forge/app' --filter '@cold-forge/landing' dev",
    "emulators": "bun run --filter '@cold-forge/functions' build && bunx firebase-tools@15.32.1 emulators:start --only auth,firestore,functions --project demo-coldforge",
    "dev:emulators": "bun run --filter '@cold-forge/app' --filter '@cold-forge/admin' dev:emulators",
    "dev:app": "bun run --filter '@cold-forge/app' dev",
    "dev:landing": "bun run --filter '@cold-forge/landing' dev",
    "preview:cards": "bun run --filter '@cold-forge/share-card' preview",
    "build": "bun run --filter '@cold-forge/app' --filter '@cold-forge/landing' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
