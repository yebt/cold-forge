# COLD FORGE API — environment variables.
# Copy to apps/api/.env for local development (Bun loads .env automatically). Never commit real values.

# NODE_ENV is set by the package scripts: `bun run dev` → development, `bun run start` → production,
# `bun test` → test. It must be exactly production, development or test (case/whitespace-insensitive);
# anything else, or unset, REFUSES TO START. Do not set it here.
# "production" enables strict checks: the server refuses to start without AUTH_SECRET (high entropy),
# SMTP_HOST + MAIL_FROM, APP_URL (https, no query/fragment) and CORS_ORIGINS (https only, plus the
# Capacitor webview origins). It also turns on HSTS.

# Listen address. PORT=0 picks a random free port.
# Default: 127.0.0.1 in development/test (loopback only), 0.0.0.0 in production.
PORT=3001
HOST=127.0.0.1

# SQLite file (WAL mode; keep the -wal/-shm files next to it). Back it up; it holds user data.
# The server creates/chmods it (and -wal/-shm) as 0600.
DATABASE_PATH=cold-forge.sqlite

# Secret pepper for HMAC of login codes, link tokens and session tokens. At least 32 bytes, and in
# production at least 16 distinct characters (a repeated or patterned value is refused).
# Generate with: openssl rand -base64 48
# Rotating it invalidates every pending login and every session (everyone signs in again).
# Development without it: a random one is generated per start (sessions do not survive restarts).
AUTH_SECRET=

# Public URL of the web app. The emailed link is ${APP_URL}/#/auth?token=...
# Required (https) in production. No query string or fragment. Dev default: http://localhost:5173
APP_URL=http://localhost:5173

# Comma-separated list of EXACT origins allowed by CORS (scheme://host[:port], no paths, no "*").
# Required in production, where every entry must be https:// except the Capacitor webview origins
# capacitor://localhost, https://localhost and http://localhost. Dev default:
#   http://localhost:5173,http://localhost:4321,capacitor://localhost,http://localhost,https://localhost
CORS_ORIGINS=

# Number of reverse proxies in front of the API whose X-Forwarded-For you trust.
# 0 = use the socket address (direct exposure). 1 = one proxy (e.g. nginx, Fly, Render).
# Setting this without a proxy lets clients spoof their IP and dodge rate limits.
TRUST_PROXY=0

# SMTP for login emails. REQUIRED in every environment, except local development with the
# console mailer below.
SMTP_HOST=
# 587 = STARTTLS (always required: the server refuses to send if the upgrade fails), 465 = implicit TLS.
SMTP_PORT=587
# Defaults to true when SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender, e.g.: COLD FORGE <login@yourdomain.com>
MAIL_FROM=
# DEVELOPMENT ONLY: 1 = allow plain-text SMTP (no STARTTLS), e.g. a local Mailpit/MailHog.
# Refused in any other environment.
SMTP_INSECURE_DEV=

# DEVELOPMENT ONLY: 1 = print login codes and links to the console instead of emailing them.
# Only honored with NODE_ENV=development AND a loopback HOST (127.0.0.1, ::1, localhost);
# refused in any other environment. Leave SMTP_HOST empty to use it. Typical local setup: 1.
DEV_CONSOLE_MAILER=

# Global cap on login emails sent per hour by this server (protects the sender reputation and
# SMTP quota). Over it, requests still get 202 but nothing is sent and a warning is logged.
MAIL_HOURLY_CAP=500
