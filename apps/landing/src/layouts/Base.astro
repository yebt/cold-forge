---
import "../styles/global.css";
import { LOCALE_NAMES } from "@cold-forge/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { APP_URL } from "astro:env/client";
import { LOCALES, useCopy, type Locale } from "../i18n/index.ts";
import Fonts from "../components/Fonts.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, m } = useCopy(locale);
const site = Astro.site ?? new URL("https://coldforge.work");
const canonical = new URL(getRelativeLocaleUrl(locale), site).href;
const alternates = LOCALES.map((l) => ({ locale: l, href: new URL(getRelativeLocaleUrl(l), site).href }));
const ogLocales = LOCALES.filter((l) => l !== locale).map((l) => useCopy(l).t.meta.ogLocale);
const ogImage = new URL(`/og/og-${locale}.png`, site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#05070a" />
    <meta name="color-scheme" content="dark" />
    <Fonts />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.appName} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {ogLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${m.appName} — ${m.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="page">
      <a class="skip" href="#main">{t.a11y.skip}</a>

      <header class="site-header">
        <div class="bar">
          <a class="brand" href={getRelativeLocaleUrl(locale)} aria-label={t.a11y.home}>COLD FORGE</a>
          <nav class="nav" aria-label={t.a11y.mainNav}>
            <a class="nav-link" href="#deal">{t.nav.deal}</a>
            <a class="nav-link" href="#arc">{t.nav.arc}</a>
            <a class="nav-link" href="#faq">{t.nav.faq}</a>
            <a class="nav-cta" href={APP_URL}>{t.nav.cta}</a>
          </nav>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container foot">
          <span class="foot-brand">COLD FORGE</span>
          <nav aria-label={t.a11y.language}>
            <ul class="langs">
              {
                LOCALES.map((l) => (
                  <li>
                    <a href={getRelativeLocaleUrl(l)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined}>
                      {LOCALE_NAMES[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <p class="foot-legal">© {year} COLD FORGE · #WinterArc</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter-l);
    top: 0;
    z-index: 100;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-weight: 800;
    text-decoration: none;
    transform: translateY(-120%);
  }
  .skip:focus { transform: translateY(calc(12px + env(safe-area-inset-top))); }

  main:focus { outline: none; }

  /* Sits over the hero and scrolls away with it: never covers content further down. */
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding-top: env(safe-area-inset-top);
  }
  .bar {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--gutter-l) var(--gutter-r);
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav { display: flex; align-items: center; gap: 24px; }
  .nav-link {
    display: none;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid rgb(238 243 247 / 0.5);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    background: rgb(5 7 10 / 0.3);
    transition: border-color 0.2s, background-color 0.2s;
  }
  .nav-cta:hover { border-color: var(--text); background: rgb(238 243 247 / 0.08); }

  @media (min-width: 761px) {
    .nav-link { display: inline-flex; }
  }
  @media (max-width: 760px) {
    .bar { height: 64px; }
  }
  @media (max-width: 359px) {
    .brand { font-size: 1.125rem; letter-spacing: 0.08em; }
    .nav-cta { padding: 0 14px; font-size: 0.8125rem; }
  }

  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .foot {
    padding-block: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--dim);
  }
  .foot-brand {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.12em;
    color: var(--text);
  }
  .langs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    margin-inline: -4px;
  }
  .langs li + li::before {
    content: "·";
    margin-right: 4px;
    color: var(--dim);
  }
  .langs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 4px;
    color: var(--dim);
    text-decoration: none;
  }
  .langs a:hover { color: var(--text); }
  .langs a[aria-current="page"] { color: var(--text); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--ice); }

  @media (max-width: 760px) {
    .foot { flex-direction: column; align-items: flex-start; }
  }
</style>
