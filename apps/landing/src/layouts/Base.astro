---
import "../styles/global.css";
import { LOCALE_NAMES } from "@cold-forge/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES, useCopy, type Locale } from "../i18n/index.ts";
import Logo from "../components/Logo.astro";
import { APP_URL } from "astro:env/client";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, m } = useCopy(locale);
const site = Astro.site ?? new URL("https://coldforge.work");
const canonical = new URL(getRelativeLocaleUrl(locale), site).href;
const alternates = LOCALES.map((l) => ({ locale: l, href: new URL(getRelativeLocaleUrl(l), site).href }));
const ogLocales = LOCALES.filter((l) => l !== locale).map((l) => useCopy(l).t.meta.ogLocale);
const ogImage = new URL(`/og/og-${locale}.png`, site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#070b12" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.appName} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {ogLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${m.appName} — ${m.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">{t.a11y.skip}</a>

    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={getRelativeLocaleUrl(locale)} aria-label={t.a11y.home}>
          <Logo size={34} />
          <span class="brand-name" aria-hidden="true">COLD<span> FORGE</span></span>
        </a>

        <nav class="nav" aria-label={t.a11y.mainNav}>
          <a href="#how">{t.nav.how}</a>
          <a href="#features">{t.nav.features}</a>
          <a href="#ranks">{t.nav.ranks}</a>
          <a href="#faq">{t.nav.faq}</a>
        </nav>

        <div class="bar-end">
          <nav class="lang" aria-label={t.a11y.language}>
            <ul>
              {
                LOCALES.map((l) => (
                  <li>
                    <a
                      href={getRelativeLocaleUrl(l)}
                      hreflang={l}
                      lang={l}
                      aria-current={l === locale ? "page" : undefined}
                      title={LOCALE_NAMES[l]}
                    >
                      <span aria-hidden="true">{l.toUpperCase()}</span>
                      <span class="sr-only">{LOCALE_NAMES[l]}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a class="btn btn-fire header-cta" href={APP_URL}>{t.nav.cta}</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-brand">
          <Logo size={40} />
          <div>
            <p class="foot-name">{m.appName}</p>
            <p class="foot-tag">{m.tagline} {t.footer.line}</p>
          </div>
        </div>
        <ul class="foot-links">
          {
            LOCALES.map((l) => (
              <li>
                <a href={getRelativeLocaleUrl(l)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined}>
                  {LOCALE_NAMES[l]}
                </a>
              </li>
            ))
          }
          <li><a href="#main">{t.footer.top} ↑</a></li>
        </ul>
        <p class="foot-legal">© {year} {m.appName}. {t.footer.rights} #WinterArc</p>
      </div>
    </footer>

    <script>
      // Scroll reveal. Elements are only hidden by CSS when JS runs and motion is allowed.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--ice);
    color: var(--bg);
    font-weight: 800;
    text-decoration: none;
  }
  .skip:focus { top: 12px; }

  main:focus { outline: none; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 11 18 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgb(29 42 61 / 0.7);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-name {
    font-weight: 900;
    letter-spacing: 0.16em;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .brand-name span { color: var(--ice); }

  .nav { display: none; gap: 28px; }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav a:hover { color: var(--text); }

  .bar-end { display: flex; align-items: center; gap: 12px; }

  .lang ul {
    display: flex;
    list-style: none;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-2);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 36px;
    padding: 0 8px;
    border-radius: 9px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-decoration: none;
  }
  .lang a:hover { color: var(--text); }
  .lang a[aria-current="page"] {
    color: var(--bg);
    background: var(--ice);
  }

  .header-cta { display: none; min-height: 42px; padding: 8px 16px; font-size: 0.92rem; border-radius: 12px; }

  @media (min-width: 680px) {
    .header-cta { display: inline-flex; }
  }
  @media (min-width: 1000px) {
    .nav { display: flex; }
  }
  @media (max-width: 380px) {
    .brand-name { font-size: 0.85rem; letter-spacing: 0.12em; }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 48px 40px;
    background: linear-gradient(180deg, transparent, rgb(16 32 58 / 0.25));
  }
  .foot {
    display: grid;
    gap: 28px;
  }
  .foot-brand { display: flex; align-items: center; gap: 14px; }
  .foot-name { font-weight: 900; letter-spacing: 0.16em; }
  .foot-tag { color: var(--muted); font-size: 0.95rem; }
  .foot-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .foot-links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .foot-links a:hover,
  .foot-links a[aria-current="page"] { color: var(--ice); }
  .foot-legal { color: var(--muted); font-size: 0.85rem; }

  @media (min-width: 860px) {
    .foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .foot-legal { grid-column: 1 / -1; }
  }
</style>
