---
/**
 * `/` — static hosting can't read Accept-Language, so this tiny page picks the locale
 * client-side from `navigator.languages` (same rules as the app: pt-BR → pt, es-MX → es, else en)
 * and `location.replace`s to it before anything paints. Without JS the visitor sees plain
 * language links instead of being forced into English.
 */
import { DEFAULT_LOCALE, LOCALE_NAMES, LOCALES, getMessages } from "@cold-forge/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const site = Astro.site ?? new URL("https://coldforge.app");
const en = getMessages(DEFAULT_LOCALE);
const targets = Object.fromEntries(LOCALES.map((l) => [l, getRelativeLocaleUrl(l)]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en.appName}</title>
    <meta name="description" content={en.tagline} />
    <meta name="theme-color" content="#070b12" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(getRelativeLocaleUrl(DEFAULT_LOCALE), site).href} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
    <script is:inline define:vars={{ targets, locales: LOCALES, fallback: DEFAULT_LOCALE }}>
      (function () {
        var tags = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
        var pick = fallback;
        for (var i = 0; i < tags.length; i++) {
          var base = String(tags[i]).split("-")[0].toLowerCase();
          if (locales.indexOf(base) !== -1) { pick = base; break; }
        }
        location.replace(targets[pick] + location.hash);
      })();
    </script>
    <style>
      html { color-scheme: dark; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 16px;
        box-sizing: border-box;
        background: radial-gradient(circle at top, #10203a 0%, #070b12 60%) #070b12;
        color: #e6f0ff;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        text-align: center;
      }
      h1 { font-weight: 900; letter-spacing: 0.3em; color: #7dd3fc; font-size: 1rem; margin: 0 0 8px; }
      p { font-size: 1.6rem; font-weight: 900; margin: 0 0 24px; }
      ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
      a { display: inline-block; padding: 12px 20px; border-radius: 12px; border: 1px solid #2a3b55; color: #e6f0ff; font-weight: 800; text-decoration: none; }
      a:hover, a:focus-visible { border-color: #7dd3fc; outline: none; }
    </style>
  </head>
  <body>
    <main>
      <h1>{en.appName}</h1>
      <p>❄️ ⚒️ 🔥</p>
      <ul>
        {
          LOCALES.map((l) => (
            <li>
              <a href={getRelativeLocaleUrl(l)} hreflang={l} lang={l}>
                {LOCALE_NAMES[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
