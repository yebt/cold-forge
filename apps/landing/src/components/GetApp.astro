---
import { APK_URL, APP_URL } from "astro:env/client";
import { useCopy, type Locale } from "../i18n/index.ts";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { t } = useCopy(Astro.props.locale);
/** Android, Apple, desktop — same order as `t.install.platforms`. */
const icons = [
  { fill: "#3ddc84", d: "M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22a11.5 11.5 0 0 0-9.84 0L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z" },
  { fill: "currentColor", d: "M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.5 1-1.4 1.3-2.7 1.4-2.8-.1 0-2.6-1-2.2-4.1zM13.9 4.9c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z" },
  { fill: "#7dd3fc", d: "M3 4h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-7v2h3v2H7v-2h3v-2H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v9h16V6z" },
];
---

<section id="get-app" class="section" aria-labelledby="get-app-title">
  <div class="container">
    <div class="panel" data-reveal>
      <div class="heat" aria-hidden="true"></div>
      <div class="inner">
        <Logo size={64} />
        <p class="kicker">{t.install.kicker}</p>
        <h2 id="get-app-title" class="h2">{t.install.title}</h2>
        <p class="lead">{t.install.sub}</p>

        <div class="actions">
          <a class="btn btn-fire btn-lg" href={APP_URL}>{t.install.open} <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={APK_URL} rel="noopener">{t.install.apk} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="note">{t.install.apkNote}</p>

        <ol class="platforms">
          {
            t.install.platforms.map((p, i) => (
              <li class="platform">
                <h3>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill={icons[i]?.fill} d={icons[i]?.d} />
                  </svg>
                  {p.name}
                </h3>
                <ol class="steps">
                  {p.steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </li>
            ))
          }
        </ol>

        <p class="guest"><span aria-hidden="true">❄️</span> {t.install.guest}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(600px 300px at 50% 120%, rgb(249 115 22 / 0.3), transparent 70%),
      radial-gradient(500px 260px at 0% 0%, rgb(56 189 248 / 0.16), transparent 70%),
      linear-gradient(180deg, #0f1724, #070b12);
    box-shadow: 0 50px 100px -50px var(--ember-glow);
  }
  .heat {
    position: absolute;
    inset: auto 32px 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--grad-fire);
  }
  .inner {
    position: relative;
    padding: clamp(32px, 7vw, 72px) clamp(18px, 6vw, 72px);
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .inner > :global(.logo) { margin-bottom: 20px; }
  .lead { margin-inline: auto; }
  .actions {
    margin-top: 32px;
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: 420px;
  }
  .btn-lg { min-height: 58px; font-size: 1.08rem; border-radius: 16px; }
  .note { margin-top: 12px; color: var(--muted); font-size: 0.9rem; }

  .platforms {
    list-style: none;
    margin-top: 40px;
    display: grid;
    gap: 12px;
    width: 100%;
    text-align: left;
  }
  .platform {
    padding: 18px 20px;
    border-radius: 18px;
    background: rgb(7 11 18 / 0.6);
    border: 1px solid var(--border);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 900;
    margin-bottom: 10px;
  }
  .steps {
    padding-left: 1.3em;
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .steps li::marker { color: var(--ice); font-weight: 900; }
  .guest {
    margin-top: 28px;
    color: var(--ice-pale);
    font-weight: 700;
    font-size: 0.95rem;
    max-width: 52ch;
  }

  @media (min-width: 600px) {
    .actions { grid-template-columns: auto auto; max-width: none; width: auto; }
  }
  @media (min-width: 860px) {
    .platforms { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
