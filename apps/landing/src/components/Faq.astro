---
import { useCopy, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}
const { t } = useCopy(Astro.props.locale);
---

<section id="faq" class="faq section" aria-labelledby="faq-title">
  <div class="container narrow">
    <h2 id="faq-title" class="display title">{t.faq.title}</h2>
    <div class="list">
      {
        t.faq.items.map((item, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span class="q">{item.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <p class="a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { background: var(--bg); padding-block: clamp(88px, 10vw, 120px); }
  .narrow { max-width: calc(860px + var(--gutter-l) + var(--gutter-r)); display: flex; flex-direction: column; gap: 36px; }
  .title { font-size: clamp(2.5rem, 6vw, 3.5rem); line-height: 1; }
  .list { border-top: 1px solid var(--border); }

  details { border-bottom: 1px solid var(--border); }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding: 18px 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
    touch-action: manipulation;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .q { color: #fff; }
  summary:focus-visible { outline-offset: 2px; }

  /* A "+" drawn in CSS that turns into a "×" when open. */
  .icon {
    position: relative;
    flex: 0 0 18px;
    height: 18px;
    color: var(--muted);
    transition: transform 0.25s ease;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: currentColor;
  }
  .icon::after { transform: rotate(90deg); }
  details[open] .icon { transform: rotate(45deg); color: var(--text); }

  .a {
    padding: 0 48px 22px 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Smooth open/close where supported (Chromium 131+); elsewhere it simply toggles. */
  @media (prefers-reduced-motion: no-preference) {
    @supports selector(::details-content) {
      details { interpolate-size: allow-keywords; }
      details::details-content {
        block-size: 0;
        overflow: clip;
        transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
      }
      details[open]::details-content { block-size: auto; }
    }
  }

  @media (max-width: 760px) {
    .a { padding-right: 0; }
  }
</style>
