---
/** The COLD FORGE mark (brand/logo.svg, served as /favicon.svg). */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img src="/favicon.svg" width={size} height={size} alt="" class="logo" decoding="async" />

<style>
  .logo { flex-shrink: 0; border-radius: 22%; filter: drop-shadow(0 4px 14px rgb(249 115 22 / 0.22)); }
</style>
