---
import { useCopy, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}
const { t } = useCopy(Astro.props.locale);
---

<section class="privacy" aria-label={t.a11y.privacy}>
  <ul class="container items">
    {
      t.privacy.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .privacy {
    padding-block: clamp(56px, 7vw, 72px);
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 28px 32px;
  }
  li { display: flex; flex-direction: column; gap: 6px; padding-left: 16px; border-left: 2px solid var(--border); }
  h3 { font-size: 1.0625rem; font-weight: 700; line-height: 1.3; }
  p { font-size: 0.9375rem; line-height: 1.55; color: var(--muted); }
</style>
