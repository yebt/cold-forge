---
import { FORGE_RANKS, type RankId } from "@cold-forge/core";
import { fmt, useCopy, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}
const { t, m } = useCopy(Astro.props.locale);

/** Metal colour per rank, from cold ore to white-hot ice. */
const TINT: Record<RankId, string> = {
  ore: "#8b7d6b",
  iron: "#94a3b8",
  steel: "#cbd5e1",
  tempered: "#fb923c",
  damascus: "#f97316",
  iceForged: "#7dd3fc",
};
const last = FORGE_RANKS.length - 1;
---

<section id="ranks" class="section ranks" aria-labelledby="ranks-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">{t.ranks.kicker}</p>
      <h2 id="ranks-title" class="h2">{t.ranks.title}</h2>
      <p class="lead">{t.ranks.sub}</p>
    </header>

    <ol class="ladder">
      {
        FORGE_RANKS.map((r, i) => (
          <li
            class:list={["rung", { top: i === last }]}
            style={`--tint:${TINT[r.id]};--i:${i};--reveal-delay:${i * 80}ms`}
            data-reveal
          >
            <span class="lvl" aria-hidden="true">{i + 1}</span>
            <span class="emoji" aria-hidden="true">{r.emoji}</span>
            <span class="info">
              <span class="name">{m.ranks[r.id]}</span>
              <span class="req">
                {r.minPerfectDays === 0 ? t.ranks.start : fmt(t.ranks.perfectDays, { n: r.minPerfectDays })}
              </span>
            </span>
            <span class="pillar" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ranks {
    background:
      radial-gradient(700px 400px at 80% 80%, rgb(125 211 252 / 0.08), transparent 70%),
      linear-gradient(180deg, transparent, rgb(16 32 58 / 0.25) 50%, transparent);
  }
  .ladder {
    list-style: none;
    display: grid;
    gap: 10px;
    position: relative;
  }
  .rung {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--tint) 12%, #0f1724), #0b121d 80%);
    border: 1px solid color-mix(in srgb, var(--tint) 30%, #1d2a3d);
  }
  .rung.top {
    box-shadow: 0 0 0 1px rgb(125 211 252 / 0.3), 0 20px 50px -20px rgb(56 189 248 / 0.5);
  }
  .lvl {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--tint);
    width: 18px;
    text-align: center;
  }
  .emoji {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-size: 1.55rem;
    border-radius: 14px;
    background: #070b12;
    border: 1px solid color-mix(in srgb, var(--tint) 45%, transparent);
    box-shadow: 0 0 20px -6px var(--tint);
  }
  .info { display: grid; min-width: 0; }
  .name { font-weight: 900; font-size: 1.15rem; letter-spacing: -0.01em; }
  .req { color: var(--muted); font-weight: 700; font-size: 0.92rem; }
  .pillar { display: none; }

  @media (min-width: 900px) {
    .ladder {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      align-items: end;
      gap: 14px;
    }
    .rung {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 20px 18px 0;
      overflow: hidden;
    }
    .lvl { position: absolute; top: 14px; right: 14px; width: auto; }
    .emoji { width: 56px; height: 56px; font-size: 1.8rem; }
    .info { gap: 2px; }
    .name { font-size: 1.1rem; line-height: 1.15; min-height: 2.3em; display: flex; align-items: flex-end; }
    .pillar {
      display: block;
      align-self: stretch;
      margin: 6px -18px 0;
      height: calc(28px + var(--i) * 34px);
      background:
        repeating-linear-gradient(0deg, transparent 0 17px, rgb(255 255 255 / 0.04) 17px 18px),
        linear-gradient(180deg, color-mix(in srgb, var(--tint) 45%, transparent), transparent);
      border-top: 2px solid var(--tint);
    }
  }
</style>
