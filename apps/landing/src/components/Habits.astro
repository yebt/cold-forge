---
import { HABIT_TEMPLATES } from "@cold-forge/core";
import { useCopy, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}
const { t, m } = useCopy(Astro.props.locale);
---

<section id="habits" class="section" aria-labelledby="habits-title">
  <div class="container">
    <header class="section-head center" data-reveal>
      <p class="kicker">{t.habits.kicker}</p>
      <h2 id="habits-title" class="h2">{t.habits.title}</h2>
      <p class="lead">{t.habits.sub}</p>
    </header>

    <ul class="chips" data-reveal>
      {
        HABIT_TEMPLATES.map((h, i) => (
          <li class:list={["chip", { hot: i % 3 === 0 }]}>
            <span class="e" aria-hidden="true">{h.emoji}</span>
            {m.habits[h.id]}
          </li>
        ))
      }
      <li class="chip custom">
        <span class="e" aria-hidden="true">＋</span>
        {t.habits.custom}
      </li>
    </ul>
  </div>
</section>

<style>
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 900px;
    margin-inline: auto;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 10px;
    border-radius: 99px;
    background: var(--panel);
    border: 1px solid var(--border-strong);
    font-weight: 800;
    font-size: 1rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .chip:hover { transform: translateY(-2px); border-color: var(--ice); }
  .chip.hot { border-color: rgb(249 115 22 / 0.45); box-shadow: 0 8px 30px -14px var(--ember-glow); }
  .e {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-2);
    font-size: 1.05rem;
  }
  .custom {
    border-style: dashed;
    background: transparent;
    color: var(--ice);
  }
  .custom .e { background: rgb(125 211 252 / 0.12); color: var(--ice); font-weight: 900; }

  @media (min-width: 720px) {
    .chip { font-size: 1.08rem; padding: 12px 22px 12px 12px; }
    .e { width: 38px; height: 38px; }
  }
</style>
