---
/**
 * Self-hosted fonts (no third-party requests, so the CSP can stay `'self'`).
 * Only the latin + latin-ext woff2 subsets are bundled; `unicode-range` means latin-ext is only
 * downloaded when a page actually uses those glyphs (en/es/pt fit in latin). Vite fingerprints the
 * files into /_astro/ (immutable cache). The hero display face is preloaded.
 */
import antonLatin from "@fontsource/anton/files/anton-latin-400-normal.woff2?url";
import antonLatinExt from "@fontsource/anton/files/anton-latin-ext-400-normal.woff2?url";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import archivoLatinExt from "@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url";
import monoLatin from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import monoLatinExt from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-400-normal.woff2?url";

const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const LATIN_EXT =
  "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";

const faces: { family: string; weight: string; src: string; range: string }[] = [
  { family: "Anton", weight: "400", src: antonLatin, range: LATIN },
  { family: "Anton", weight: "400", src: antonLatinExt, range: LATIN_EXT },
  { family: "Archivo", weight: "100 900", src: archivoLatin, range: LATIN },
  { family: "Archivo", weight: "100 900", src: archivoLatinExt, range: LATIN_EXT },
  { family: "IBM Plex Mono", weight: "400", src: monoLatin, range: LATIN },
  { family: "IBM Plex Mono", weight: "400", src: monoLatinExt, range: LATIN_EXT },
];

const css = faces
  .map(
    (f) =>
      `@font-face{font-family:"${f.family}";font-style:normal;font-weight:${f.weight};font-display:swap;` +
      `src:url(${f.src}) format("woff2");unicode-range:${f.range}}`,
  )
  .join("\n");
---

<link rel="preload" href={antonLatin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />
