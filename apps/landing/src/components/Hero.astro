---
import { ARC_DAYS } from "@cold-forge/core";
import { APK_URL, APP_URL } from "astro:env/client";
import { fmt, useCopy, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = useCopy(locale);
const c = t.hero.countdown;

/** Flakes on wide screens; CSS keeps only the first 40 on phones. */
const FLAKES = 96;

// Deterministic snowfall (same Park–Miller generator as the mockup): identical markup on every build.
let seed = 7;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const flakes = Array.from({ length: FLAKES }, () => {
  const size = 1 + rnd() * 2.6;
  const dur = 9 + rnd() * 14;
  return [
    `--x:${(rnd() * 100).toFixed(2)}%`,
    `--s:${size.toFixed(1)}px`,
    `--o:${(0.25 + rnd() * 0.6).toFixed(2)}`,
    `--d:${dur.toFixed(1)}s`,
    `--delay:${(-rnd() * dur).toFixed(1)}s`,
    `--drift:${(10 + rnd() * 30).toFixed(0)}px`,
  ].join(";");
});
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <div class="snow">
      {flakes.map((style) => <span style={style}></span>)}
    </div>
    <div class="glow"></div>
    <svg class="ridges" viewBox="0 0 1440 260" preserveAspectRatio="none" focusable="false">
      <path d="M0 170 L140 110 L230 150 L360 60 L470 140 L560 100 L690 30 L820 130 L930 90 L1050 150 L1170 70 L1290 140 L1440 100 L1440 260 L0 260 Z" fill="#0B121A"></path>
      <path d="M0 210 L120 170 L260 205 L400 150 L540 200 L700 140 L860 205 L1010 165 L1150 210 L1300 160 L1440 195 L1440 260 L0 260 Z" fill="#05070A"></path>
      <path d="M690 30 L715 48 L700 46 L688 60 L676 47 L664 50 Z" fill="#DDE8F0" opacity="0.7"></path>
      <path d="M360 60 L382 78 L368 76 L357 88 L346 77 L338 80 Z" fill="#DDE8F0" opacity="0.5"></path>
      <path d="M1170 70 L1190 86 L1176 84 L1167 96 L1157 85 L1150 88 Z" fill="#DDE8F0" opacity="0.5"></path>
    </svg>
  </div>

  <div class="inner container">
    <p class="label eyebrow">{fmt(t.hero.eyebrow, { days: ARC_DAYS })}</p>
    <h1 id="hero-title" class="display title">
      <span>{t.hero.titleA}</span>
      <span class="ice">{t.hero.titleB}</span>
      <span>{t.hero.titleC}</span>
    </h1>
    <p class="sub">{t.hero.sub}</p>
    <div class="ctas">
      <a class="btn btn-light" href={APP_URL}>
        {t.hero.start}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn btn-ghost" href={APK_URL} rel="noopener">{t.hero.apk}</a>
    </div>
    <p class="trust">{t.hero.trust}</p>
  </div>

  <div
    class="countdown"
    data-countdown
    data-total={ARC_DAYS}
    data-to-jan={c.toJan}
    data-to-jan-one={c.toJanOne}
    data-day={c.day}
    data-to-arc={c.toArc}
    data-to-arc-one={c.toArcOne}
    data-to-next={c.toNext}
  >
    <p class="count-row">
      <span class="count-num" data-cd-num>{ARC_DAYS}</span>
      <span class="count-label" data-cd-label>{c.fallback}</span>
    </p>
    <p class="count-day" data-cd-day hidden></p>
  </div>
</section>

<script>
  import { ARC_DAYS, diffDays, localToday, winterArcWindow } from "@cold-forge/core";

  const fill = (tpl: string, values: Record<string, number>) =>
    tpl.replace(/\{(\w+)\}/g, (m, k: string) => (k in values ? String(values[k]) : m));

  /**
   * Arc-aware countdown, on the visitor's local calendar:
   * - Oct 1 → Dec 31: days until January 1, plus "Day X of 92".
   * - Apr → Sep: days until the arc starts.
   * - Jan → Mar: the arc just ended; days until the next one.
   */
  function render(root: HTMLElement) {
    const d = root.dataset;
    const num = root.querySelector<HTMLElement>("[data-cd-num]");
    const label = root.querySelector<HTMLElement>("[data-cd-label]");
    const dayEl = root.querySelector<HTMLElement>("[data-cd-day]");
    if (!num || !label || !dayEl) return;

    const today = localToday();
    const year = Number(today.slice(0, 4));
    const { startDate, endDate } = winterArcWindow(year);
    let n: number;
    let text: string;
    let dayText = "";

    if (today >= startDate && today <= endDate) {
      n = diffDays(today, `${year + 1}-01-01`);
      text = (n === 1 ? d.toJanOne : d.toJan) ?? "";
      dayText = fill(d.day ?? "", { day: diffDays(startDate, today) + 1, total: ARC_DAYS });
    } else {
      n = diffDays(today, startDate);
      const justEnded = Number(today.slice(5, 7)) <= 3;
      text = (justEnded ? d.toNext : n === 1 ? d.toArcOne : d.toArc) ?? "";
    }

    num.textContent = String(n);
    label.textContent = text;
    dayEl.textContent = dayText;
    dayEl.hidden = !dayText;
  }

  document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
    render(el);
    // Roll over at midnight if the tab stays open.
    setInterval(() => render(el), 60_000);
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: flex;
    flex-direction: column;
    /* Small-viewport units: the hero fits under the mobile URL bar without jumping as it hides. */
    min-height: 100vh;
    min-height: 100svh;
    background: radial-gradient(120% 70% at 50% 0%, #10202e 0%, #070b10 55%, var(--bg) 100%);
  }

  /* Decorative layers: absolute inside the hero, never capture touches. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .snow span {
    position: absolute;
    top: -12px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #e6f1f8;
    opacity: var(--o);
    transform: translate3d(0, -20px, 0);
    animation: fall var(--d) linear var(--delay) infinite;
  }
  @keyframes fall {
    from { transform: translate3d(0, -20px, 0); }
    to { transform: translate3d(var(--drift), 110svh, 0); }
  }
  /* Fewer flakes on phones. */
  @media (max-width: 760px) {
    .snow span:nth-child(n + 41) { display: none; }
  }

  .glow {
    position: absolute;
    left: 50%;
    top: 38%;
    width: min(720px, 150vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(124 196 234 / 0.16), rgb(124 196 234 / 0) 70%);
    opacity: 0.45;
    transform: translate(-50%, -50%);
    animation: breath 7s ease-in-out infinite;
  }
  @keyframes breath {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.35; }
    50% { transform: translate(-50%, -50%) scale(1.08); opacity: 0.6; }
  }

  .ridges {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: clamp(150px, 18vw, 260px);
  }

  @media (prefers-reduced-motion: reduce) {
    .snow { display: none; }
    .glow { animation: none; }
  }

  .inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
    max-width: 1280px;
    padding-top: calc(108px + env(safe-area-inset-top));
    padding-bottom: 36px;
  }

  .eyebrow { color: var(--muted); }

  .title {
    /* Bounded by width and height so the whole hero (and the countdown) fits a laptop screen. */
    font-size: clamp(2.5rem, min(13.5vw, 13vh), 11rem);
    font-size: clamp(2.5rem, min(13.5vw, 13svh), 11rem);
    line-height: var(--display-lh);
    text-wrap: initial;
    max-width: 100%;
  }

  .sub {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.55;
    color: #b8c6d3;
    max-width: 620px;
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }
  .ctas .btn-ghost { padding-inline: 26px; font-size: 1rem; }

  .trust { font-size: 0.8125rem; color: var(--dim); }

  .countdown {
    position: relative;
    padding: 0 var(--gutter-r) calc(36px + env(safe-area-inset-bottom)) var(--gutter-l);
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .count-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .count-num {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .count-day { color: var(--dim); font-size: 0.75rem; }

  @media (max-width: 760px) {
    .inner { gap: 24px; padding-top: calc(104px + env(safe-area-inset-top)); padding-bottom: 40px; }
    .ctas { width: 100%; flex-direction: column; }
    .ctas .btn { width: 100%; padding-inline: 20px; }
    .eyebrow { letter-spacing: 0.22em; }
    .countdown { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
    .count-num { font-size: 2.125rem; }
  }
</style>
