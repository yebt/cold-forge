---
import { ARC_DAYS } from "@cold-forge/core";
import { useCopy, type Locale } from "../i18n/index.ts";
import PhoneMock from "./PhoneMock.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = useCopy(locale);
const c = t.hero.countdown;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="frost" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow intro"><span class="dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="intro" style="--intro-delay:60ms">
        <span class="wordmark">COLD FORGE</span>
        <span class="line">{t.hero.titleA}</span>
        <span class="line hot"><span class="fire-text">{t.hero.titleB}</span></span>
      </h1>
      <p class="sub intro" style="--intro-delay:120ms">{t.hero.sub}</p>

      <div
        class="countdown card intro"
        style="--intro-delay:180ms"
        data-countdown
        data-total={ARC_DAYS}
        data-upcoming={c.upcoming}
        data-upcoming-one={c.upcomingOne}
        data-upcoming-sub={c.upcomingSub}
        data-active={c.active}
        data-active-sub={c.activeSub}
        data-active-sub-last={c.activeSubLast}
        data-finished={c.finished}
        data-finished-sub={c.finishedSub}
      >
        <div class="cd-row">
          <span class="cd-label">❄️ {c.label}</span>
          <span class="cd-live" aria-hidden="true"></span>
        </div>
        <p class="cd-main" data-cd-main aria-live="polite">{c.fallback}</p>
        <p class="cd-sub" data-cd-sub hidden></p>
        <div class="cd-bar" aria-hidden="true"><span data-cd-bar></span></div>
      </div>

      <div class="ctas intro" style="--intro-delay:240ms">
        <a class="btn btn-fire" href="#waitlist">{t.hero.waitlist} →</a>
        <div class="stores">
          {/* TODO: replace "#" with the real store URLs at launch. */}
          <a class="store" href="#" aria-disabled="true">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.5 1-1.4 1.3-2.7 1.4-2.8-.1 0-2.6-1-2.2-4.1zM13.9 4.9c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"></path>
            </svg>
            <span class="store-text"><small>{t.hero.downloadOn}</small>{t.hero.appStore}</span>
            <span class="soon">{t.hero.comingSoon}</span>
          </a>
          <a class="store" href="#" aria-disabled="true">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path fill="#38bdf8" d="M4 2.6 13.6 12 4 21.4c-.4-.2-.6-.6-.6-1.1V3.7c0-.5.2-.9.6-1.1z"></path>
              <path fill="#7dd3fc" d="m16.7 8.9-3.1 3.1L4 2.6l.2-.1c.4-.2.9-.2 1.3 0z"></path>
              <path fill="#f97316" d="M13.6 12l3.1 3.1-11.2 6.4c-.4.2-.9.2-1.3 0L4 21.4z"></path>
              <path fill="#fb923c" d="m20.3 10.9-3.6-2-3.1 3.1 3.1 3.1 3.6-2c.8-.5.8-1.7 0-2.2z"></path>
            </svg>
            <span class="store-text"><small>{t.hero.getItOn}</small>{t.hero.googlePlay}</span>
            <span class="soon">{t.hero.comingSoon}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="visual intro" style="--intro-delay:200ms">
      <PhoneMock locale={locale} />
    </div>
  </div>
</section>

<script>
  import { ARC_DAYS, diffDays, localToday, winterArcWindow } from "@cold-forge/core";

  const fill = (tpl: string, values: Record<string, number>) =>
    tpl.replace(/\{(\w+)\}/g, (m, k: string) => (k in values ? String(values[k]) : m));

  function render(root: HTMLElement) {
    const d = root.dataset;
    const main = root.querySelector<HTMLElement>("[data-cd-main]");
    const sub = root.querySelector<HTMLElement>("[data-cd-sub]");
    const bar = root.querySelector<HTMLElement>("[data-cd-bar]");
    if (!main || !sub || !bar) return;

    const today = localToday();
    const year = Number(today.slice(0, 4));
    const { startDate, endDate } = winterArcWindow(year);
    let state: "upcoming" | "active" | "finished";
    let mainText: string;
    let subText: string;
    let progress = 0;

    if (today < startDate) {
      const n = diffDays(today, startDate);
      // Jan–Mar: last winter's arc just wrapped up. Apr–Sep: next one is coming.
      if (Number(today.slice(5, 7)) <= 3) {
        state = "finished";
        mainText = d.finished ?? "";
        subText = fill(d.finishedSub ?? "", { n });
        progress = 1;
      } else {
        state = "upcoming";
        mainText = n === 1 ? (d.upcomingOne ?? "") : fill(d.upcoming ?? "", { n });
        subText = d.upcomingSub ?? "";
      }
    } else if (today <= endDate) {
      state = "active";
      const day = diffDays(startDate, today) + 1;
      const left = ARC_DAYS - day;
      mainText = fill(d.active ?? "", { day, total: ARC_DAYS });
      subText = left === 0 ? (d.activeSubLast ?? "") : fill(d.activeSub ?? "", { n: left });
      progress = day / ARC_DAYS;
    } else {
      state = "finished";
      mainText = d.finished ?? "";
      subText = "";
      progress = 1;
    }

    root.dataset.state = state;
    main.textContent = mainText;
    sub.textContent = subText;
    sub.hidden = !subText;
    bar.style.width = `${Math.max(progress * 100, state === "active" ? 2 : 0)}%`;
  }

  document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
    render(el);
    // Roll over at midnight if the tab stays open.
    setInterval(() => render(el), 60_000);
  });
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(40px, 8vw, 96px) clamp(72px, 10vw, 120px);
    overflow: clip;
  }
  .frost {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(600px 380px at 85% 30%, rgb(249 115 22 / 0.14), transparent 70%),
      radial-gradient(700px 420px at 10% 0%, rgb(125 211 252 / 0.14), transparent 70%),
      repeating-linear-gradient(115deg, rgb(125 211 252 / 0.025) 0 2px, transparent 2px 22px);
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .copy { display: grid; gap: 22px; min-width: 0; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    padding: 7px 14px 7px 10px;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    background: rgb(15 23 36 / 0.7);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ice-pale);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 0 4px rgb(249 115 22 / 0.2), 0 0 12px var(--ember);
  }

  h1 {
    display: grid;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-size: clamp(2.9rem, 13.5vw, 6.2rem);
  }
  .wordmark {
    font-size: clamp(0.85rem, 2.6vw, 1rem);
    letter-spacing: 0.42em;
    color: var(--ice);
    margin-bottom: 14px;
    line-height: 1;
  }
  .line { display: block; width: fit-content; max-width: 100%; text-wrap: balance; }
  .hot { padding-bottom: 0.08em; filter: drop-shadow(0 6px 26px rgb(249 115 22 / 0.25)); }
  .hot .fire-text { -webkit-box-decoration-break: clone; box-decoration-break: clone; }

  .sub {
    color: var(--muted);
    font-size: clamp(1.05rem, 2.6vw, 1.25rem);
    max-width: 54ch;
    text-wrap: pretty;
  }

  .countdown {
    padding: 18px 20px;
    display: grid;
    gap: 8px;
    max-width: 480px;
    border-color: rgb(56 189 248 / 0.25);
    box-shadow: 0 20px 50px -30px var(--ice-glow);
  }
  .cd-row { display: flex; justify-content: space-between; align-items: center; }
  .cd-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ice);
  }
  .cd-live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
  }
  [data-state="active"] .cd-live { background: var(--ember); box-shadow: 0 0 0 4px rgb(249 115 22 / 0.2); }
  .cd-main { font-size: clamp(1.4rem, 5vw, 1.8rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.15; }
  .cd-sub { color: var(--muted); font-size: 0.95rem; }
  .cd-bar { height: 8px; border-radius: 99px; background: var(--border); overflow: hidden; margin-top: 6px; }
  .cd-bar span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ice-strong), var(--ember));
    box-shadow: 0 0 12px var(--ember-glow);
    transition: width 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-state="active"] .cd-live { animation: pulse 1.8s ease-in-out infinite; }
  }
  @keyframes pulse {
    50% { box-shadow: 0 0 0 8px rgb(249 115 22 / 0); }
  }

  .ctas { display: grid; gap: 14px; }
  .ctas > .btn { justify-self: stretch; }
  .stores { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .store {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    min-height: 56px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: #05080d;
    color: var(--text);
    text-decoration: none;
    cursor: not-allowed;
  }
  .store-text { display: grid; font-weight: 800; font-size: 0.98rem; line-height: 1.15; }
  .store-text small { font-size: 0.66rem; font-weight: 600; color: var(--muted); }
  .soon {
    position: absolute;
    top: -9px;
    right: 8px;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--ember);
    color: #1a0a02;
  }

  .visual { min-width: 0; }

  @media (min-width: 560px) {
    .ctas { grid-template-columns: auto; justify-items: start; }
    .ctas > .btn { justify-self: start; }
    .stores { display: flex; flex-wrap: wrap; }
    .store { min-width: 190px; }
  }

  @media (min-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 48px; }
    h1 { font-size: clamp(4rem, 6.6vw, 6.2rem); }
  }
</style>
