---
import { ARC_DAYS, FORGE_RANKS, HABIT_TEMPLATES } from "@cold-forge/core";
import { fmt, useCopy, type Locale } from "../i18n/index.ts";
import { mockHeat } from "../lib/heat.ts";

interface Props {
  locale: Locale;
}
const { t, m } = useCopy(Astro.props.locale);

const DAY = 23;
const STREAK = 12;
const rank = FORGE_RANKS.find((r) => r.id === "steel")!;
const pct = Math.round((DAY / ARC_DAYS) * 100);
const heat = mockHeat(DAY, 11);
const habits = HABIT_TEMPLATES.filter((h) => ["coldShower", "gym", "read"].includes(h.id));
const streaks = [23, 12, 18];
---

<section id="share" class="section" aria-labelledby="share-title">
  <div class="container grid">
    <div class="copy" data-reveal>
      <p class="kicker">{t.share.kicker}</p>
      <h2 id="share-title" class="h2">{t.share.title}</h2>
      <p class="lead">{t.share.sub}</p>
      <ul class="points">
        {t.share.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="stage" data-reveal style="--reveal-delay:120ms">
      <figure class="story" role="img" aria-label={t.a11y.cardMock}>
        <div class="story-inner" aria-hidden="true">
          <div class="s-top">
            <span class="s-brand">COLD FORGE</span>
            <span class="s-arc">❄️ {t.share.cardArc}</span>
          </div>

          <div class="s-day">
            <span class="s-day-label">{m.stats.day(DAY, ARC_DAYS).split(/\s/)[0]}</span>
            <span class="s-day-num">{DAY}<small>/{ARC_DAYS}</small></span>
            <span class="s-pct">{m.share.ofArc(pct)}</span>
            <span class="s-bar"><span style={`width:${pct}%`}></span></span>
          </div>

          <div class="s-stats">
            <div>
              <span class="s-k">{m.stats.perfectStreak}</span>
              <span class="s-v">🔥 {fmt(t.share.streakDays, { n: STREAK })}</span>
            </div>
            <div>
              <span class="s-k">{m.stats.rank}</span>
              <span class="s-v">{rank.emoji} {m.ranks[rank.id]}</span>
            </div>
          </div>

          <div class="s-heat">
            {heat.map((v) => <span data-heat={v} />)}
          </div>

          <ul class="s-habits">
            {
              habits.map((h, i) => (
                <li>
                  <span>
                    {h.emoji} {m.habits[h.id]}
                  </span>
                  <b>{streaks[i]}🔥</b>
                </li>
              ))
            }
          </ul>

          <p class="s-foot">{m.share.footer}</p>
        </div>
      </figure>
      <div class="ember-orb" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 56px;
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  .points {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .points li {
    position: relative;
    padding-left: 34px;
    font-weight: 700;
  }
  .points li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 1px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 900;
    background: var(--ice);
    color: var(--bg);
  }

  .stage { position: relative; display: grid; place-items: center; padding: 10px 0; }
  .ember-orb {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(249 115 22 / 0.4), rgb(56 189 248 / 0.12) 60%, transparent);
    filter: blur(40px);
    z-index: 0;
  }
  .story {
    position: relative;
    z-index: 1;
    width: min(100%, 300px);
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    padding: 1px;
    background: linear-gradient(160deg, rgb(125 211 252 / 0.6), rgb(29 42 61 / 0.6) 40%, rgb(249 115 22 / 0.7));
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.85);
    transform: rotate(2.5deg);
  }
  .story-inner {
    height: 100%;
    border-radius: 27px;
    padding: 22px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    background:
      radial-gradient(260px 200px at 100% 100%, rgb(249 115 22 / 0.28), transparent 70%),
      radial-gradient(260px 220px at 0% 0%, rgb(56 189 248 / 0.22), transparent 70%),
      #070b12;
    font-size: 12px;
  }
  .s-top { display: flex; justify-content: space-between; align-items: center; }
  .s-brand { font-weight: 900; letter-spacing: 0.3em; font-size: 9.5px; color: var(--ice); }
  .s-arc { font-weight: 800; font-size: 10px; padding: 3px 8px; border-radius: 99px; border: 1px solid var(--border-strong); }

  .s-day { display: grid; gap: 4px; margin-top: 6px; }
  .s-day-label { text-transform: uppercase; letter-spacing: 0.3em; font-weight: 800; font-size: 11px; color: var(--muted); }
  .s-day-num {
    font-size: 84px;
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.06em;
    background: linear-gradient(180deg, #fff 10%, var(--ice) 55%, var(--ice-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .s-day-num small { font-size: 26px; letter-spacing: -0.02em; -webkit-text-fill-color: var(--muted); }
  .s-pct { font-weight: 800; color: var(--ember-soft); font-size: 11.5px; }
  .s-bar { height: 6px; border-radius: 99px; background: #1d2a3d; overflow: hidden; }
  .s-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--ice-strong), var(--ember)); }

  .s-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .s-stats div { display: grid; gap: 2px; padding: 9px 10px; border-radius: 12px; background: rgb(15 23 36 / 0.85); border: 1px solid var(--border); min-width: 0; }
  .s-k { font-size: 8px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; }
  .s-v { font-weight: 900; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .s-heat { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: 3px; }
  .s-heat span { aspect-ratio: 1; border-radius: 2.5px; }

  .s-habits { list-style: none; display: grid; gap: 5px; }
  .s-habits li { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; font-weight: 700; font-size: 11px; }
  .s-habits li span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s-habits b { color: var(--ember-soft); }

  .s-foot { margin-top: auto; text-align: center; font-size: 9.5px; font-weight: 800; color: var(--muted); letter-spacing: 0.02em; }

  @media (min-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; }
    .story { width: 330px; }
  }
</style>
