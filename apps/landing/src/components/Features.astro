---
import { FORGE_RANKS } from "@cold-forge/core";
import { fmt, useCopy, type Locale } from "../i18n/index.ts";
import { mockHeat } from "../lib/heat.ts";

interface Props {
  locale: Locale;
}
const { t, m } = useCopy(Astro.props.locale);
const f = t.features.items;
const first = FORGE_RANKS[0]!;
const last = FORGE_RANKS[FORGE_RANKS.length - 1]!;

type Key = keyof typeof f;
const items: { key: Key; icon: string; className?: string }[] = [
  { key: "heatmap", icon: "🟧", className: "wide tall" },
  { key: "checkins", icon: "⚡" },
  { key: "streaks", icon: "🔥" },
  { key: "ranks", icon: "⚔️" },
  { key: "cards", icon: "📲" },
  { key: "reminders", icon: "🔔" },
  { key: "offline", icon: "✈️" },
  { key: "languages", icon: "🌎", className: "wide" },
];
const heat = mockHeat(61);
const body = (key: Key) =>
  key === "ranks" ? fmt(f.ranks.body, { from: m.ranks[first.id], to: m.ranks[last.id] }) : f[key].body;
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">{t.features.kicker}</p>
      <h2 id="features-title" class="h2">{t.features.title}</h2>
    </header>

    <ul class="grid">
      {
        items.map((it, i) => (
          <li class:list={["feat card", it.className]} data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
            <span class="icon" aria-hidden="true">{it.icon}</span>
            <h3>{f[it.key].title}</h3>
            <p>{body(it.key)}</p>
            {it.key === "heatmap" && (
              <div class="heatmap" aria-hidden="true">
                {heat.map((v) => (
                  <span data-heat={v} />
                ))}
              </div>
            )}
            {it.key === "languages" && (
              <div class="langs" aria-hidden="true">
                <span lang="en">Forge yourself.</span>
                <span lang="es">Fórjate.</span>
                <span lang="pt">Forje-se.</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(0, 1fr);
  }
  .feat {
    padding: 24px;
    display: grid;
    gap: 10px;
    align-content: start;
    transition: border-color 0.25s, transform 0.25s;
  }
  .feat:hover { border-color: var(--border-strong); }
  .icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    font-size: 1.35rem;
    border-radius: 14px;
    background: linear-gradient(160deg, var(--bg-2), var(--panel-2));
    border: 1px solid var(--border-strong);
    margin-bottom: 6px;
  }
  h3 { font-size: 1.2rem; font-weight: 900; letter-spacing: -0.015em; line-height: 1.2; }
  p { color: var(--muted); font-size: 1rem; }

  .tall { background: radial-gradient(500px 300px at 100% 100%, rgb(249 115 22 / 0.12), transparent 70%), linear-gradient(180deg, #0f1724, #0b121d); }

  .heatmap {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 4px;
  }
  .heatmap span { aspect-ratio: 1; border-radius: 4px; }

  .langs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .langs span {
    padding: 6px 12px;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--ice-pale);
  }

  @media (max-width: 639px) {
    .feat {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 16px;
      row-gap: 4px;
      padding: 20px;
    }
    .icon { grid-row: span 2; margin-bottom: 0; }
    .heatmap, .langs { grid-column: 1 / -1; }
  }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wide { grid-column: span 2; }
    .heatmap { grid-template-columns: repeat(23, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 16px; }
    .tall { grid-row: span 2; }
    .heatmap { grid-template-columns: repeat(14, minmax(0, 1fr)); margin-top: auto; padding-top: 18px; }
    .tall { align-content: stretch; grid-template-rows: auto auto auto 1fr; }
  }
</style>
