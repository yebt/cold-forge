# COLD FORGE app — build-time settings. Vite exposes only VITE_* variables, and everything here
# ships in the public bundle: never put secrets here. Production values live in .env.production.

# Firebase web config (Firebase console → Project settings → Your apps → Web app).
# Public by design; security comes from Auth, the Firestore rules, authorized domains and API key
# restrictions. Without these the app runs guest-only and hides sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# 1 = use the local emulators (auth :9099, firestore :8080): `bunx firebase-tools emulators:start --only auth,firestore`
VITE_USE_EMULATORS=

# 1 = in-memory fake Firebase for UI tests (Playwright). Dead code in production builds.
# NEVER set this for a build you deploy.
VITE_FIREBASE_MOCK=
