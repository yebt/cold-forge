# COLD FORGE app — build-time settings (Vite exposes only VITE_* variables to the bundle).
# Copy to apps/app/.env.local for local overrides. Never put secrets here: everything is public.

# Base URL of the sync API. Must be https:// in production; the app refuses to send tokens to
# plain http:// unless it is localhost. Its origin is also added to the page's CSP connect-src.
VITE_API_URL=http://localhost:3001
