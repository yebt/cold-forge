# Local development against the Firebase emulators (no real project, no real API key).
# `demo-*` project ids are offline-only: the SDKs never reach Google with them.
# Start the emulators first: `bun run emulators` (repo root).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-coldforge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-coldforge
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_STORAGE_BUCKET=demo-coldforge.appspot.com
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=1
