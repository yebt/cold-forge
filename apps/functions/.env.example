# Deploy params (firebase-functions/params). Real values: .env.<projectId> (committed, not secret)
# and .env.local (emulator only, gitignored).
ADMIN_REGION=us-central1
# CORS origin of the admin panel (exact, no trailing slash).
ADMIN_ORIGIN=https://admin.example.com
# true = reject callables without a valid App Check token. Needs App Check (reCAPTCHA Enterprise)
# wired into apps/admin first (VITE_APPCHECK_SITE_KEY), otherwise the panel stops working.
ADMIN_ENFORCE_APP_CHECK=false
# ADMIN_ALLOWED_EMAILS is a Secret Manager secret (comma-separated emails), NOT an env var, and it
# is the whole admin role: verified Google accounts with one of those emails are admins.
#   firebase functions:secrets:set ADMIN_ALLOWED_EMAILS --project <projectId>   # then redeploy
# Empty or unset = every admin call is refused (fail closed).
# Emulator only: ADMIN_EMULATOR_ALLOWED_EMAILS (see .env.demo-coldforge) is used when the secret has
# no value there (no .secret.local). It is ignored outside the Functions emulator.
