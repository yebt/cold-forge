# Deploy-time params for project coldforge-work (not secrets). See README.md.
ADMIN_REGION=us-central1
ADMIN_ORIGIN=https://admin.coldforge.work
ADMIN_ENFORCE_APP_CHECK=false
# ADMIN_ALLOWED_EMAILS is NOT here on purpose: it names the owner and this repo is public. It is a
