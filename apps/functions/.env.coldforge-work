# Deploy-time params for project coldforge-work (not secrets). See README.md.
ADMIN_REGION=us-central1
ADMIN_ORIGIN=https://admin.coldforge.work
ADMIN_ENFORCE_APP_CHECK=false
# Never true in production unless you really want every admin-claim holder to have admin powers.
ADMIN_ALLOW_ANY_ADMIN=false
# ADMIN_ALLOWED_EMAILS is NOT here on purpose: it names the owner and this repo is public. It is a
# Cloud Secret Manager secret, set once with `firebase functions:secrets:set ADMIN_ALLOWED_EMAILS`
# (the deploy also prompts for it if it is missing). While it is unset or empty, every admin call
# is refused (fail closed). Don't add it here: a secret and an env var can't share a name.
