# Params for the offline emulator project `demo-coldforge` only (`bun run emulators`,
# `bun run test:emulators`). Never used by a deploy to coldforge-work. Nothing secret.
ADMIN_REGION=us-central1
ADMIN_ORIGIN=http://localhost:5174
ADMIN_ENFORCE_APP_CHECK=false
# Emulator-only admin list (the production list is the ADMIN_ALLOWED_EMAILS secret). Read only when
# FUNCTIONS_EMULATOR=true and the secret has no value. Odd case and spacing on purpose: the
# integration suite checks that emails are normalized. In the Auth emulator's fake Google picker,
# sign in as admin@example.com to get into the admin panel.
ADMIN_EMULATOR_ALLOWED_EMAILS=" Admin@Example.com ,second-admin@example.com"
