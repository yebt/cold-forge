# Copy to .env.local for `bun run dev` against a real project (production values live in .env.production).
# These are public by design: they ship in the bundle. Security comes from the server-side admin checks (ADMIN_ALLOWED_EMAILS)
# in apps/functions, Auth authorized domains, API key restrictions and Cloudflare Access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must match ADMIN_REGION in apps/functions.
VITE_FUNCTIONS_REGION=us-central1

# Dev only: talk to the local emulators (auth :9099, functions :5001). Refused in production builds.
# VITE_USE_EMULATORS=1
# Dev only: fake data layer with fixtures, no Firebase at all (`bun run dev:mock`). Never bundled.
# VITE_ADMIN_MOCK=1

# Optional Firebase App Check: reCAPTCHA Enterprise site key. Unset = off (default). When set, the
# callables carry App Check tokens and the CSP allows the reCAPTCHA hosts; only then set
# ADMIN_ENFORCE_APP_CHECK=true in apps/functions. See docs/deploy.md ("App Check").
# VITE_APPCHECK_SITE_KEY=
